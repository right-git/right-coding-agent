ENV="dev"
LLM_API_KEY="sk-..."
LLM_API_BASE="https://openrouter.ai/api/v1"
LLM_DEFAULT_MODEL="google/gemini-3.7-flash"
# Heavy local models are opt-in; with the flags off nothing downloads or loads.
# Vision: registers screen_locate/screen_click and preloads the LocateAnything
# locator (multi-GB). Off leaves screenshot/type/key/scroll available.
ENABLE_VISION_MODEL="0"
# Voice: starts push-to-talk and loads whisper ASR (+ Silero TTS for /voice).
ENABLE_VOICE_MODEL="0"